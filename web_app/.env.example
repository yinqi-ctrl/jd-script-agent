# ===== 复制本文件为 .env 并填入你自己的 key =====
# 不要在任何聊天/公开仓库里贴出真实 key

# ===== 大模型（OpenAI 兼容协议，支持 OpenRouter / 智谱 / DeepSeek / OpenAI 等）=====
# 例：用 OpenRouter（推荐，一个 key 可用几十个模型，含免费模型）
#   注册：https://openrouter.ai  →  API Keys 页面复制 key
LLM_API_KEY=你的OpenRouterKey
# OpenRouter 默认接口地址（不用改）
LLM_BASE_URL=https://openrouter.ai/api/v1
# 你想用的模型（OpenRouter 上的模型名，免费模型比如 google/gemma-2-9b-it 或 meta-llama/llama-3.1-8b-instruct）
# 注意：必须有 JSON 输出能力。推荐用带 json 支持的模型，详见下方 README。
LLM_MODEL=google/gemma-2-9b-it

# 备选：用智谱 GLM-4-Flash（免费额度）
# LLM_API_KEY=你的智谱key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ===== 联网搜索（Tavily，免费额度注册：https://tavily.com）=====
# 留空则自动跳过联网，仅用知识库+模型知识
TAVILY_API_KEY=你的tavilykey

# 知识库目录（默认指向本作业的知识库，一般不用改）
KB_DIR=d:/桌面/智能体作业/知识库

# 服务端口
PORT=5000
